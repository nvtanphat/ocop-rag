# OCOP GraphRAG — local deployment settings
# LLM: an OpenAI-compatible API serves candidate extraction (OCOP_EXTRACT_*) and answers/routing (OCOP_ANSWER_*).
# The answer settings fall back to the extraction ones. Put the real key only in the untracked .env.
OCOP_EXTRACT_LLM_PROVIDER=openai
OCOP_EXTRACT_OPENAI_BASE_URL=https://api.modelapi.vn/v1
# OCOP_EXTRACT_OPENAI_API_KEY=
OCOP_EXTRACT_LLM_MODEL=gpt-6-sol
OCOP_ANSWER_LLM_PROVIDER=openai
# OCOP_ANSWER_LLM_MODEL=
# OCOP_ANSWER_OPENAI_BASE_URL=
# OCOP_ANSWER_OPENAI_API_KEY=
# OCOP_EXTRACT_LLM_WORKERS=4
# OCOP_EXTRACT_LLM_GLEANINGS=1
# Embedding and reranker models and their pinned revisions are set in configs/ocop_models.yaml, not here.
# The one scan OCR path is EasyOCR CRAFT detection + VietOCR VGG Transformer recognition.
# Provision both model files locally; extraction does not download weights or call a remote service.
# OCOP_EASYOCR_MODEL_DIR=D:/models/easyocr
# OCOP_VIETOCR_WEIGHTS=data/models/vietocr/vgg_transformer.pth  (keep model weights under data/models)
# OCR dataset consumed by RAG; must contain the complete locked source inventory.
# OCOP_OCR_DATASET=data/ocr-dataset
# Set a unique secret before exposing optional Neo4j service
NEO4J_PASSWORD=CHANGE_ME
# Neo4j container memory (docker-compose.yml); publishing the graph needs about 1g of heap
# NEO4J_HEAP=1g
# NEO4J_PAGECACHE=256m

# Retrieval: sparse (BM25) or hybrid (dense + Qdrant); OCOP_RERANK=1 adds the cross-encoder to hybrid/dense requests
# OCOP_RETRIEVAL_PROFILE=hybrid
# OCOP_RERANK=1
# Let the model propose an intent for questions no deterministic signal covers (one extra model call; default off)
# OCOP_LLM_ROUTER=1

# Production release safety (development defaults disabled)
OCOP_ENFORCE_RELEASE_GATE=0
# Optional durable LangGraph for authenticated non-private sessions only
OCOP_LANGGRAPH_CHECKPOINT_ENABLED=0
# OCOP_LANGGRAPH_CHECKPOINT_PATH=D:\OCOP_PRIVATE\checkpoints.sqlite
# Configure OTEL SDK/exporter in the application process when monitoring is available
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

